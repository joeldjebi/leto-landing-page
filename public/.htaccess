# VITE · landing page (Apache)

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Cache : les fichiers de assets/ ont un nom unique à chaque version (cache long), la page jamais
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Sécurité : la carte vient d'OpenFreeMap, les polices de Google Fonts.
  # On retire d'abord la règle héritée du site principal (public_html/.htaccess), sinon les deux s'appliquent
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' https://tiles.openfreemap.org https://api.vite.ci; img-src 'self' data: blob: https://tiles.openfreemap.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Toujours en HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Lien de suivi court (vite.ci/<jeton>) : page de suivi de l'espace web
  RewriteRule ^([0-9a-f]{32})/?$ /pro/#/suivi/$1 [NE,R=302,L]
</IfModule>
